                       149     ;Set TimerMode for Timer0 to 1
00B1 758901            150     MOV TMOD, #001h
                       151     ;Set the hight and low bits (16 Bits therefore two registers) for timer0
                       152     ;One tick is 1 micro second since 500 ms (intended duration does not fit into 16 bit)
                       153     ;The timer will go down 10 times before a tick. Therfore one countdown is 50,000 mirco secs
                       154     ;The 16 bits can hold 65,535 numbers, so for an overflow 65,536 is needed
                       155     ;--> 50,000 ticks to every overflow 65,536-50,000=15,536 as initial value
00B4 758CF8            156     MOV TH0, #0F8H;#03CH
00B7 758A00            157     MOV TL0, #000H;#03CH
