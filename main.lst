                       337     ;Set initial tick counter to 10
0196 753401            338     MOV TimersToPass, #001h;#00Ah
                       339     ;Set initial direction to left
                       340     ;MOV DirecFacing, #001h
                       341     ;Set TimerMode for Timer0 to 1
0199 758901            342     MOV TMOD, #001h
                       343     ;Set the hight and low bits (16 Bits therefore two registers) for timer0
                       344     ;One tick is 1 micro second since 500 ms (intended duration does not fit into 16 bit)
                       345     ;The timer will go down 10 times before a tick. Therfore one countdown is 50,000 mirco secs
                       346     ;The 16 bits can hold 65,535 numbers, so for an overflow 65,536 is needed
                       347     ;--> 50,000 ticks to every overflow 65,536-50,000=15,536 as initial value
019C 758CF8            348     MOV TH0, #0F8H;#03CH
019F 758A00            349     MOV TL0, #000H;#03CH
                       350     ;Enable interrupts globally and the timer interrupts
01A2 75A882            351     MOV IE, #82H
                       352     ;Start timer0
01A5 D28C              353     SETB TR0
                       354
01A7 8043              355     SJMP Main
                       356
