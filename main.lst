0186 753401            332     MOV TimersToPass, #001h;#00Ah
                       333     ;Set initial direction to left
                       334     ;MOV DirecFacing, #001h
                       335     ;Set TimerMode for Timer0 to 1
0189 758901            336     MOV TMOD, #001h
                       337     ;Set the hight and low bits (16 Bits therefore two registers) for timer0
                       338     ;One tick is 1 micro second since 500 ms (intended duration does not fit into 16 bit)
                       339     ;The timer will go down 10 times before a tick. Therfore one countdown is 50,000 mirco secs
                       340     ;The 16 bits can hold 65,535 numbers, so for an overflow 65,536 is needed
                       341     ;--> 50,000 ticks to every overflow 65,536-50,000=15,536 as initial value
018C 758CF8            342     MOV TH0, #0F8H;#03CH
018F 758A00            343     MOV TL0, #000H;#03CH
                       344     ;Enable interrupts globally and the timer interrupts
0192 75A882            345     MOV IE, #82H
                       346     ;Start timer0
0195 D28C              347     SETB TR0
                       348
0197 8076              349     SJMP Main
                       350
                       351     Timer0_IR:
                       352     ;Save context to stack
0199 C0E0              353     PUSH ACC
019B C0D0              354     PUSH PSW
019D C0F0              355     PUSH B
019F C000              356     PUSH 00H
01A1 C001              357     PUSH 01H
                       358     ;Reload timer values
01A3 758CF8            359     MOV TH0, #0F8H
01A6 758A00            360     MOV TL0, #000H
                       361     ;Decrease timer counter
01A9 D53458            362     DJNZ TimersToPass, End_IR
                       363     ;If 0 timers left, reset to 10 and execute movement
01AC 753401            364     MOV TimersToPass, #001h ; Reset tick counter[cite: 2]
